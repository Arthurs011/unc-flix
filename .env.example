# Copy to .env and fill in your own values. Never commit the real .env.
# Supabase -> Project Settings -> API

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...). This one is safe in the browser bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional, only used by tooling that talks to the project id directly.
VITE_SUPABASE_PROJECT_ID=
